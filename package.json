{
  "name": "briefroom",
  "version": "1.0.0",
  "private": true,
  "description": "BriefRoom - turn a customer's vague \"something like this\" into a clear, approved visual brief. Built on the Nexconn Chat SDK and Chat UI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:live": "tsx --env-file-if-exists=.env.local --test tests/live/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/db/migrate.ts",
    "db:import-json": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/db/import-json.ts",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@hookform/resolvers": "^7.0.8",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@nexconn/chat": "26.5.1",
    "@nexconn/chatui": "26.5.0",
    "@nexconn/engine": "26.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "lit": "^3.3.3",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
