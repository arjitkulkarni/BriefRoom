{
  "name": "briefroom",
  "version": "1.0.0",
  "private": true,
  "description": "BriefRoom - turn a customer's vague \"something like this\" into a clear, approved visual brief. Built on the Nexconn Chat SDK and Chat UI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@nexconn/chat": "26.5.1",
    "@nexconn/chatui": "26.5.0",
    "@nexconn/engine": "26.5.1",
    "express": "^5.3.0",
    "lit": "^3.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
