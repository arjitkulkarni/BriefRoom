# ---------- Nexconn (required) ----------
# Console -> your app -> App Key page: https://console.nexconn.ai/agile/apps/km
NEXCONN_APP_KEY=your-app-key
NEXCONN_APP_SECRET=your-app-secret
# Must match the data center you chose when creating the app.
# Singapore (default, best for India): api.sg-light-api.com / api-b.sg-light-api.com
# North America: api.us-light-api.com / api-b.us-light-api.com
NEXCONN_API_DOMAIN=api.sg-light-api.com
NEXCONN_API_DOMAIN_BACKUP=api-b.sg-light-api.com
# Client data center: SG | NA | SA | OM (must match the app)
NEXCONN_AREA=SG

# ---------- Server ----------
PORT=8787
# Public URL used in share links (leave empty to use the browser's origin)
PUBLIC_URL=
# Where db.json and uploaded images are stored (use a persistent disk in production)
# DATA_DIR=/var/data
