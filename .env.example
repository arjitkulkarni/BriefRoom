# BriefRoom environment template — copy to `.env` (or let `neon env pull` write `.env.local`).
# Never put real credentials in this file. Every variable is explained in docs/CONFIGURATION.md.
# Only the API server reads these; nothing here is exposed to the browser (no VITE_ variables).

# ---------------------------------------------------------------- Application
NODE_ENV=development
PORT=8787
# Public HTTPS origin used in share links. Required in production; must not be localhost there.
# On Render it defaults to RENDER_EXTERNAL_URL (the onrender.com URL); set it for a custom domain.
PUBLIC_URL=
# Where development data lives (embedded DB, local uploads, generated dev secret).
DATA_DIR=./data

# ---------------------------------------------------------------- Security
# Signs reference-image URLs. Required in production: 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------- Neon PostgreSQL
# Pooled connection string (host contains "-pooler") for application queries.
DATABASE_URL=
# Direct (unpooled) connection string, used by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------- Nexconn (Chat SDK + Server API)
# Which credential pair the server uses: development | production (default: production when NODE_ENV=production).
NEXCONN_ENVIRONMENT=development
NEXCONN_DEV_APP_KEY=
NEXCONN_DEV_APP_SECRET=
NEXCONN_PROD_APP_KEY=
NEXCONN_PROD_APP_SECRET=
# Data centre of YOUR app in the Nexconn Console: sg (Singapore) | na (North America) | sa (Saudi Arabia).
# A wrong value fails token issuance with "App-Key is not exist" (HTTP 403) — `npm run test:live` checks it.
# Sets both the Server API hosts and the Chat SDK AreaCode. Required once keys are set.
NEXCONN_REGION=

# ---------------------------------------------------------------- File storage
# s3 = Neon Object Storage (S3-compatible, default when AWS_ENDPOINT_URL_S3 is set) | local = disk
UPLOAD_PROVIDER=local
# Local provider only:
UPLOADS_DIR=./data/uploads
# S3 provider: written by `neon deploy` / `neon env pull` for the bucket declared in neon.ts.
S3_BUCKET=assets
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ---------------------------------------------------------------- AI ambiguity detection (optional)
# Deterministic rules always run (labelled "Rules check"). With a key, an AI model adds grounded questions.
# auto (default) = OpenAI first, then Grok as fallback · openai | xai = that one first, the other as fallback · rules = no AI.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Grok by xAI (OpenAI-compatible API at https://api.x.ai/v1).
XAI_API_KEY=
XAI_MODEL=grok-4.20-non-reasoning

# ---------------------------------------------------------------- Live demo
# Ready-made /demo orders kept waiting so the page opens instantly (default: 2 production, 1 development).
# DEMO_POOL_SIZE=2
